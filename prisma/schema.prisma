generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  CHALLAN_OUT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements StockMovement[]
  challans       Challan[]

  @@map("users")
}

model Product {
  id           String   @id @default(cuid())
  productCode  String  @unique
  name         String
  sku          String   @unique
  category     String?
  unitPrice    Decimal  @db.Decimal(12, 2)
  quantity     Int      @default(0)
  minimumStock Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements StockMovement[]
  challanItems   ChallanItem[]

  @@index([name])
  @@index([category])
  @@map("products")
}

model StockMovement {
  id               String       @id @default(cuid())
  productId        String
  movementType     MovementType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reference        String?
  userId           String
  createdAt        DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("stock_movements")
}

model Challan {
  id            String   @id @default(cuid())
  challanNumber String   @unique
  receiverName  String
  destination   String
  remarks       String?
  createdBy     String
  createdAt     DateTime @default(now())

  creator User          @relation(fields: [createdBy], references: [id])
  items   ChallanItem[]

  @@index([createdBy])
  @@index([createdAt])
  @@map("challans")
}

model ChallanItem {
  id        String @id @default(cuid())
  challanId String
  productId String
  quantity  Int

  challan Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([challanId, productId])
  @@index([productId])
  @@map("challan_items")
}
